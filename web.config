<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS starts the site with `node start.js` (HttpPlatformHandler) and proxies
     requests to the port it picks. Upload this next to the contents of
     `deploy/`; output goes to logs\node_*.log in the site root. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>
    <httpPlatform processPath="node" arguments="start.js" startupTimeLimit="60" startupRetryCount="3" stdoutLogEnabled="true" stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="HOSTNAME" value="0.0.0.0" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
